{
  "rewrites": [
    {
      "source": "/api/wavespeed-v2/:path*",
      "destination": "/api/ws-proxy?p=:path*"
    },
    {
      "source": "/api/kie/:path*",
      "destination": "/api/kie-proxy?p=:path*"
    },
    {
      "source": "/api/higgsfield/:path*",
      "destination": "/api/higgsfield-proxy?p=:path*"
    }
  ]
}
